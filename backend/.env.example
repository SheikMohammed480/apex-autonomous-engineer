# Apex Agent v2.0 Configuration
OLLAMA_HOST=http://localhost:11434

# Cloud LLM API Keys (Optional - Can also be entered directly in the UI Top Banner)
# Google Gemini (Free 1,000,000 Token Context Window & 1M TPM)
GEMINI_API_KEY=

# Groq Cloud (Ultra-Fast 500+ tokens/sec Llama 3.3 70B & Qwen)
GROQ_API_KEY=

# "auto" will detect available hardware (VRAM/RAM) and select the optimal model.
# Or specify a model explicitly: gemini-2.5-flash, qwen2.5-coder:7b, qwen2.5:3b, etc.
AGENT_MODEL=auto

# Working directory the agent acts upon (defaults to workspace/ if left blank)
WORKSPACE_DIR=

# Security: require human approval for destructive shell commands
REQUIRE_SHELL_APPROVAL=false

# Host & Port
HOST=127.0.0.1
PORT=8000
